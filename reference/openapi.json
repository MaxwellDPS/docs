    "/call": {
      "post": {
        "summary": "Initiate Call",
        "description": "Initiate an outbound notification call.\n\nThe call will be made asynchronously. If callback_url is provided,\nresults will be POSTed there when the call completes.\n\nCalls are queued and processed sequentially to prevent overwhelming the SIP system.\n\nNote: callback_url is required when using choice collection.\n\nSimple notification example:\n```json\n{\n    \"message\": \"Hello, this is a reminder about your appointment.\",\n    \"extension\": \"1001\"\n}\n```\n\nChoice collection example (requires callback_url):\n```json\n{\n    \"message\": \"Hello, this is a reminder about your appointment tomorrow at 2pm.\",\n    \"extension\": \"1001\",\n    \"callback_url\": \"https://example.com/webhook\",\n    \"choice\": {\n        \"prompt\": \"Say yes to confirm or no to cancel.\",\n        \"options\": [\n            {\"value\": \"confirmed\", \"synonyms\": [\"yes\", \"yeah\", \"yep\", \"confirm\"]},\n            {\"value\": \"cancelled\", \"synonyms\": [\"no\", \"nope\", \"cancel\"]}\n        ],\n        \"timeout_seconds\": 15\n    }\n}\n```",
        "operationId": "initiate_call_call_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OutboundCallRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OutboundCallResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
