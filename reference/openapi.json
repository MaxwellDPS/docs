  },
  "components": {
    "schemas": {
      "CallStatus": {
        "type": "string",
        "enum": [
          "queued",
          "ringing",
          "answered",
          "completed",
          "no_answer",
          "failed",
          "busy"
        ],
        "title": "CallStatus",
        "description": "Status of an outbound call."
      },
      "ChoiceOption": {
        "properties": {
          "value": {
            "type": "string",
            "title": "Value",
            "description": "The value to return if selected"
          },
          "synonyms": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Synonyms",
            "description": "Alternative phrases that map to this choice"
          }
        },
        "type": "object",
        "required": [
          "value"
        ],
        "title": "ChoiceOption",
        "description": "A choice option for the user."
      },
      "ChoicePrompt": {
        "properties": {
          "prompt": {
            "type": "string",
            "title": "Prompt",
            "description": "Question to ask the user"
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/ChoiceOption"
            },
            "type": "array",
            "title": "Options",
            "description": "Valid choice options"
          },
          "timeout_seconds": {
            "type": "integer",
            "title": "Timeout Seconds",
            "description": "How long to wait for response",
            "default": 30
          },
          "repeat_count": {
            "type": "integer",
            "title": "Repeat Count",
            "description": "How many times to repeat prompt if no response",
            "default": 2
          }
        },
        "type": "object",
        "required": [
          "prompt",
          "options"
        ],
        "title": "ChoicePrompt",
        "description": "Configuration for collecting user choice."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OutboundCallRequest": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Message to speak to the recipient"
          },
          "extension": {
            "type": "string",
            "title": "Extension",
            "description": "SIP extension or phone number to call"
          },
          "callback_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Callback Url",
            "description": "Webhook URL to POST results to (required if choice is specified)"
          },
          "ring_timeout": {
            "type": "integer",
            "title": "Ring Timeout",
            "description": "Seconds to wait for call to be answered",
            "default": 30
          },
          "choice": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChoicePrompt"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional choice prompt for collecting response"
          },
          "call_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Call Id",
            "description": "Optional caller-provided ID for tracking"
          }
        },
        "type": "object",
        "required": [
          "message",
          "extension"
        ],
        "title": "OutboundCallRequest",
        "description": "Request to initiate an outbound notification call."
      },
      "OutboundCallResponse": {
        "properties": {
          "call_id": {
            "type": "string",
            "title": "Call Id"
          },
          "status": {
            "$ref": "#/components/schemas/CallStatus"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "queue_position": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Queue Position"
          }
        },
        "type": "object",
        "required": [
          "call_id",
          "status",
          "message"
        ],
        "title": "OutboundCallResponse",
        "description": "Response to outbound call request."
      },
      "ScheduledCallInfo": {
        "properties": {
          "schedule_id": {
            "type": "string",
            "title": "Schedule Id"
          },
          "extension": {
            "type": "string",
            "title": "Extension"
          },
          "scheduled_for": {
            "type": "string",
            "title": "Scheduled For"
          },
          "remaining_seconds": {
            "type": "integer",
            "title": "Remaining Seconds"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "tool": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool"
          },
          "recurring": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recurring"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "schedule_id",
          "extension",
          "scheduled_for",
          "remaining_seconds",
          "status"
        ],
        "title": "ScheduledCallInfo",
        "description": "Information about a scheduled call."
      },
      "ScheduledCallRequest": {
        "properties": {
          "extension": {
            "type": "string",
            "title": "Extension",
            "description": "SIP extension or phone number to call"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message",
            "description": "Message to speak (if no tool specified)"
          },
          "tool": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool",
            "description": "Tool to execute and speak result (e.g., WEATHER)"
          },
          "tool_params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Tool Params",
            "description": "Parameters for the tool"
          },
          "delay_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Delay Seconds",
            "description": "Seconds from now to make the call"
          },
          "at_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "At Time",
            "description": "ISO datetime or HH:MM time to make the call"
          },
          "timezone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timezone",
            "description": "Timezone for at_time (default: America/Los_Angeles)",
            "default": "America/Los_Angeles"
          },
          "prefix": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prefix",
            "description": "Message to speak before tool result"
          },
          "suffix": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suffix",
            "description": "Message to speak after tool result"
          },
          "callback_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Callback Url",
            "description": "Webhook URL to POST results to"
          },
          "recurring": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recurring",
            "description": "Recurrence pattern: 'daily', 'weekdays', 'weekends', or cron expression"
          }
        },
        "type": "object",
        "required": [
          "extension"
        ],
        "title": "ScheduledCallRequest",
        "description": "Request to schedule a call for a future time."
      },
      "ScheduledCallResponse": {
        "properties": {
          "schedule_id": {
            "type": "string",
            "title": "Schedule Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "extension": {
            "type": "string",
            "title": "Extension"
          },
          "scheduled_for": {
            "type": "string",
            "title": "Scheduled For"
          },
          "delay_seconds": {
            "type": "integer",
            "title": "Delay Seconds"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "recurring": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recurring"
          }
        },
        "type": "object",
        "required": [
          "schedule_id",
          "status",
          "extension",
          "scheduled_for",
          "delay_seconds",
